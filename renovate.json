{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "pip_requirements"
  ],
  "ignorePaths": [],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "branchConcurrentLimit": 0,
  "automerge": false,
  "pip_requirements": {
    "managerFilePatterns": [
      "/^requirements\\.txt$/"
    ]
  },
  "includePaths": [
    "requirements.txt"
  ]
}
